@startuml
!define SWIMLANE_WIDTH 300

title 认领审核活动图

|用户|
start
:填写认领申请;
note right
  步骤 1：身份验证
  步骤 2：成果选择
  步骤 3：补充信息
end note
:提交申请;

|系统|
:生成申请编号;
:发送提交确认邮件;
:进入审核队列;

|管理员|
:接收待审核通知;
:查看申请详情;

if (信息完整?) then (是)
  :开始审核;

  if (身份真实?) then (否)
    :标记为"已驳回";
    |系统|
    :发送驳回通知邮件;
    |用户|
    :收到驳回通知;
    stop
  else (是)
    if (成果归属正确?) then (否)
      :标记为"已驳回";
      |系统|
      :发送驳回通知邮件;
      |用户|
      :收到驳回通知;
      stop
    else (是)
      |管理员|
      :标记为"已通过";
      |系统|
      :开通门户维护权限;
      :发送通过通知邮件;
      |用户|
      :收到通过通知;
      :访问学者门户;
      :维护个人成果;
      stop
    endif
  endif

else (否)
  |管理员|
  :标记为"需补充材料";
  :填写补充说明;
  |系统|
  :发送补充材料通知;
  |用户|
  :收到补充通知;

  if (补充材料?) then (是)
    :补充材料并重新提交;
    |系统|
    :重新进入审核队列;
    |管理员|
    :接收待审核通知;
    detach
  else (否)
    :申请超时关闭;
    stop
  endif
endif

@enduml

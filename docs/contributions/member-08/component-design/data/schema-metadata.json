{
  "tables": [
    {
      "name": "app_account",
      "purpose": "登录主体与账号有效性",
      "columns": [
        {
          "name": "account_id",
          "type": "varchar(64)",
          "required": true,
          "meaning": "服务端生成的不透明账号ID",
          "extra": "PRIMARY KEY"
        },
        {
          "name": "login_name",
          "type": "varchar(200)",
          "required": true,
          "meaning": "规范化登录名",
          "extra": "UNIQUE"
        },
        {
          "name": "password_hash",
          "type": "text",
          "required": true,
          "meaning": "经批准密码算法的验证值，不是明文",
          "extra": ""
        },
        {
          "name": "enabled",
          "type": "boolean",
          "required": true,
          "meaning": "账号当前是否允许认证",
          "extra": "DEFAULT true"
        },
        {
          "name": "auth_version",
          "type": "bigint",
          "required": true,
          "meaning": "会话撤销/权限资格校验版本",
          "extra": "DEFAULT 1 CHECK (auth_version > 0)"
        },
        {
          "name": "created_at",
          "type": "timestamptz",
          "required": true,
          "meaning": "创建时间",
          "extra": ""
        }
      ],
      "constraints": []
    },
    {
      "name": "app_role",
      "purpose": "平台角色字典",
      "columns": [
        {
          "name": "role_code",
          "type": "varchar(64)",
          "required": true,
          "meaning": "平台角色代码，初始值待确认",
          "extra": "PRIMARY KEY"
        },
        {
          "name": "description",
          "type": "text",
          "required": true,
          "meaning": "角色职责说明",
          "extra": ""
        }
      ],
      "constraints": []
    },
    {
      "name": "account_role",
      "purpose": "账号角色授予",
      "columns": [
        {
          "name": "account_id",
          "type": "varchar(64)",
          "required": true,
          "meaning": "被授予账号",
          "extra": "REFERENCES app_account(account_id)"
        },
        {
          "name": "role_code",
          "type": "varchar(64)",
          "required": true,
          "meaning": "角色",
          "extra": "REFERENCES app_role(role_code)"
        },
        {
          "name": "granted_at",
          "type": "timestamptz",
          "required": true,
          "meaning": "授予时间",
          "extra": ""
        }
      ],
      "constraints": [
        "PRIMARY KEY (account_id, role_code)"
      ]
    },
    {
      "name": "app_session",
      "purpose": "服务端可撤销会话",
      "columns": [
        {
          "name": "session_id",
          "type": "varchar(64)",
          "required": true,
          "meaning": "会话内部ID，非浏览器凭据",
          "extra": "PRIMARY KEY"
        },
        {
          "name": "account_id",
          "type": "varchar(64)",
          "required": true,
          "meaning": "所属账号",
          "extra": "REFERENCES app_account(account_id)"
        },
        {
          "name": "token_digest",
          "type": "text",
          "required": true,
          "meaning": "高熵会话令牌的摘要，不存原令牌",
          "extra": "UNIQUE"
        },
        {
          "name": "auth_version",
          "type": "bigint",
          "required": true,
          "meaning": "创建时账号校验版本",
          "extra": ""
        },
        {
          "name": "expires_at",
          "type": "timestamptz",
          "required": true,
          "meaning": "绝对失效时间",
          "extra": ""
        },
        {
          "name": "revoked_at",
          "type": "timestamptz",
          "required": false,
          "meaning": "撤销时间；空表示未显式撤销",
          "extra": ""
        },
        {
          "name": "created_at",
          "type": "timestamptz",
          "required": true,
          "meaning": "建立时间",
          "extra": ""
        }
      ],
      "constraints": []
    },
    {
      "name": "scholar",
      "purpose": "规范学者身份",
      "columns": [
        {
          "name": "scholar_id",
          "type": "varchar(64)",
          "required": true,
          "meaning": "学者ID，与账号ID分离",
          "extra": "PRIMARY KEY"
        },
        {
          "name": "display_name",
          "type": "text",
          "required": true,
          "meaning": "公开姓名，不唯一",
          "extra": ""
        },
        {
          "name": "aliases",
          "type": "jsonb",
          "required": true,
          "meaning": "公开别名数组",
          "extra": "DEFAULT '[]'::jsonb"
        },
        {
          "name": "version",
          "type": "bigint",
          "required": true,
          "meaning": "权威行版本",
          "extra": "DEFAULT 1 CHECK (version > 0)"
        }
      ],
      "constraints": []
    },
    {
      "name": "institution",
      "purpose": "规范机构",
      "columns": [
        {
          "name": "institution_id",
          "type": "varchar(64)",
          "required": true,
          "meaning": "机构ID",
          "extra": "PRIMARY KEY"
        },
        {
          "name": "display_name",
          "type": "text",
          "required": true,
          "meaning": "机构公开名称，不以名称判唯一",
          "extra": ""
        },
        {
          "name": "aliases",
          "type": "jsonb",
          "required": true,
          "meaning": "来源支持的别名数组",
          "extra": "DEFAULT '[]'::jsonb"
        }
      ],
      "constraints": []
    },
    {
      "name": "scholar_institution",
      "purpose": "带时间依据的任职关联",
      "columns": [
        {
          "name": "affiliation_id",
          "type": "varchar(64)",
          "required": true,
          "meaning": "任职关系ID",
          "extra": "PRIMARY KEY"
        },
        {
          "name": "scholar_id",
          "type": "varchar(64)",
          "required": true,
          "meaning": "学者",
          "extra": "REFERENCES scholar(scholar_id)"
        },
        {
          "name": "institution_id",
          "type": "varchar(64)",
          "required": true,
          "meaning": "机构",
          "extra": "REFERENCES institution(institution_id)"
        },
        {
          "name": "valid_from",
          "type": "date",
          "required": false,
          "meaning": "已知开始日期；未知保持NULL",
          "extra": ""
        },
        {
          "name": "valid_to",
          "type": "date",
          "required": false,
          "meaning": "已知结束日期",
          "extra": ""
        },
        {
          "name": "evidence_ref",
          "type": "text",
          "required": true,
          "meaning": "公开来源依据引用",
          "extra": ""
        }
      ],
      "constraints": [
        "CHECK (valid_to IS NULL OR valid_from IS NULL OR valid_to >= valid_from)"
      ]
    },
    {
      "name": "academic_field",
      "purpose": "规范领域分类",
      "columns": [
        {
          "name": "field_id",
          "type": "varchar(64)",
          "required": true,
          "meaning": "领域ID",
          "extra": "PRIMARY KEY"
        },
        {
          "name": "scheme_code",
          "type": "text",
          "required": true,
          "meaning": "分类体系标识",
          "extra": ""
        },
        {
          "name": "display_name",
          "type": "text",
          "required": true,
          "meaning": "领域名称",
          "extra": ""
        },
        {
          "name": "parent_field_id",
          "type": "varchar(64)",
          "required": false,
          "meaning": "分类父节点；根为空",
          "extra": "REFERENCES academic_field(field_id)"
        }
      ],
      "constraints": [
        "CHECK (parent_field_id IS NULL OR parent_field_id <> field_id)"
      ]
    },
    {
      "name": "scholar_field",
      "purpose": "有来源依据的学者规范领域分类",
      "columns": [
        {
          "name": "scholar_id",
          "type": "varchar(64)",
          "required": true,
          "meaning": "分类主体",
          "extra": "REFERENCES scholar(scholar_id)"
        },
        {
          "name": "field_id",
          "type": "varchar(64)",
          "required": true,
          "meaning": "规范领域",
          "extra": "REFERENCES academic_field(field_id)"
        },
        {
          "name": "evidence_ref",
          "type": "text",
          "required": true,
          "meaning": "公开来源分类依据，不由个人兴趣猜测",
          "extra": ""
        }
      ],
      "constraints": [
        "PRIMARY KEY (scholar_id, field_id)"
      ]
    },
    {
      "name": "achievement",
      "purpose": "规范成果主记录",
      "columns": [
        {
          "name": "work_id",
          "type": "varchar(64)",
          "required": true,
          "meaning": "去重规范成果ID",
          "extra": "PRIMARY KEY"
        },
        {
          "name": "work_type",
          "type": "text",
          "required": true,
          "meaning": "paper/patent/project/award四种",
          "extra": "CHECK (work_type IN ('paper','patent','project','award'))"
        },
        {
          "name": "title",
          "type": "text",
          "required": true,
          "meaning": "完整题名",
          "extra": ""
        },
        {
          "name": "year",
          "type": "integer",
          "required": false,
          "meaning": "已知年份；未知为NULL",
          "extra": "CHECK (year IS NULL OR year BETWEEN 1000 AND 9999)"
        },
        {
          "name": "keywords",
          "type": "jsonb",
          "required": true,
          "meaning": "公开关键词数组",
          "extra": "DEFAULT '[]'::jsonb"
        },
        {
          "name": "abstract",
          "type": "text",
          "required": false,
          "meaning": "允许公开的摘要；未知为空",
          "extra": ""
        },
        {
          "name": "visibility",
          "type": "text",
          "required": true,
          "meaning": "权威公开资格",
          "extra": "CHECK (visibility IN ('PUBLIC','PRIVATE','WITHDRAWN'))"
        },
        {
          "name": "version",
          "type": "bigint",
          "required": true,
          "meaning": "本成果单调版本",
          "extra": "DEFAULT 1 CHECK (version > 0)"
        },
        {
          "name": "simulated",
          "type": "boolean",
          "required": true,
          "meaning": "是否模拟成果",
          "extra": "DEFAULT false"
        },
        {
          "name": "updated_at",
          "type": "timestamptz",
          "required": true,
          "meaning": "权威更新时点",
          "extra": ""
        },
        {
          "name": "doi",
          "type": "text",
          "required": false,
          "meaning": "经来源/治理核实的DOI；未知为空，不把冲突覆盖为唯一事实",
          "extra": ""
        }
      ],
      "constraints": []
    },
    {
      "name": "achievement_participation",
      "purpose": "成果与学者的规范参与关系",
      "columns": [
        {
          "name": "participation_id",
          "type": "varchar(64)",
          "required": true,
          "meaning": "参与关联ID",
          "extra": "PRIMARY KEY"
        },
        {
          "name": "work_id",
          "type": "varchar(64)",
          "required": true,
          "meaning": "成果",
          "extra": "REFERENCES achievement(work_id)"
        },
        {
          "name": "scholar_id",
          "type": "varchar(64)",
          "required": true,
          "meaning": "规范学者",
          "extra": "REFERENCES scholar(scholar_id)"
        },
        {
          "name": "role_description",
          "type": "text",
          "required": false,
          "meaning": "来源支持的参与角色集合说明；未知为NULL",
          "extra": ""
        },
        {
          "name": "ordinal",
          "type": "integer",
          "required": false,
          "meaning": "来源给出的顺序",
          "extra": "CHECK (ordinal IS NULL OR ordinal > 0)"
        },
        {
          "name": "evidence_ref",
          "type": "text",
          "required": true,
          "meaning": "公开参与关系依据",
          "extra": ""
        }
      ],
      "constraints": [
        "UNIQUE (work_id, scholar_id)",
        "UNIQUE (participation_id, scholar_id)"
      ]
    },
    {
      "name": "achievement_institution",
      "purpose": "成果发生时机构关系",
      "columns": [
        {
          "name": "work_id",
          "type": "varchar(64)",
          "required": true,
          "meaning": "成果",
          "extra": "REFERENCES achievement(work_id)"
        },
        {
          "name": "institution_id",
          "type": "varchar(64)",
          "required": true,
          "meaning": "成果发生时机构",
          "extra": "REFERENCES institution(institution_id)"
        },
        {
          "name": "evidence_ref",
          "type": "text",
          "required": true,
          "meaning": "历史归属证据；不从现任机构推断",
          "extra": ""
        }
      ],
      "constraints": [
        "PRIMARY KEY (work_id, institution_id)"
      ]
    },
    {
      "name": "achievement_field",
      "purpose": "成果领域关系",
      "columns": [
        {
          "name": "work_id",
          "type": "varchar(64)",
          "required": true,
          "meaning": "成果",
          "extra": "REFERENCES achievement(work_id)"
        },
        {
          "name": "field_id",
          "type": "varchar(64)",
          "required": true,
          "meaning": "规范领域",
          "extra": "REFERENCES academic_field(field_id)"
        },
        {
          "name": "evidence_ref",
          "type": "text",
          "required": true,
          "meaning": "分类依据",
          "extra": ""
        }
      ],
      "constraints": [
        "PRIMARY KEY (work_id, field_id)"
      ]
    },
    {
      "name": "source_record",
      "purpose": "单成果粒度来源身份，数据岗衔接",
      "columns": [
        {
          "name": "source_record_id",
          "type": "varchar(64)",
          "required": true,
          "meaning": "单成果来源记录ID",
          "extra": "PRIMARY KEY"
        },
        {
          "name": "source_code",
          "type": "text",
          "required": true,
          "meaning": "经批准来源代码",
          "extra": ""
        },
        {
          "name": "external_key",
          "type": "text",
          "required": true,
          "meaning": "来源内稳定键",
          "extra": ""
        },
        {
          "name": "current_work_id",
          "type": "varchar(64)",
          "required": false,
          "meaning": "当前规范映射；未映射为空",
          "extra": "REFERENCES achievement(work_id)"
        },
        {
          "name": "license_ref",
          "type": "text",
          "required": true,
          "meaning": "许可/使用依据引用",
          "extra": ""
        },
        {
          "name": "source_url",
          "type": "text",
          "required": true,
          "meaning": "公开来源地址",
          "extra": ""
        },
        {
          "name": "version",
          "type": "bigint",
          "required": true,
          "meaning": "来源记录版本",
          "extra": "DEFAULT 1 CHECK (version > 0)"
        }
      ],
      "constraints": [
        "UNIQUE (source_code, external_key)"
      ]
    },
    {
      "name": "scholar_portal",
      "purpose": "学者公开门户",
      "columns": [
        {
          "name": "portal_id",
          "type": "varchar(64)",
          "required": true,
          "meaning": "内部不透明门户ID",
          "extra": "PRIMARY KEY"
        },
        {
          "name": "scholar_id",
          "type": "varchar(64)",
          "required": true,
          "meaning": "门户展示主体",
          "extra": "REFERENCES scholar(scholar_id)"
        },
        {
          "name": "intro",
          "type": "text",
          "required": false,
          "meaning": "授权内个人说明",
          "extra": ""
        },
        {
          "name": "version",
          "type": "bigint",
          "required": true,
          "meaning": "门户版本",
          "extra": "DEFAULT 1 CHECK (version > 0)"
        },
        {
          "name": "updated_at",
          "type": "timestamptz",
          "required": true,
          "meaning": "最近更新时点",
          "extra": ""
        },
        {
          "name": "interests",
          "type": "jsonb",
          "required": true,
          "meaning": "授权内个人兴趣字符串数组；不当作规范领域ID",
          "extra": "DEFAULT '[]'::jsonb"
        }
      ],
      "constraints": [
        "UNIQUE (scholar_id)",
        "UNIQUE (portal_id, scholar_id)"
      ]
    },
    {
      "name": "portal_display",
      "purpose": "可选个人展示配置",
      "columns": [
        {
          "name": "portal_id",
          "type": "varchar(64)",
          "required": true,
          "meaning": "门户",
          "extra": "REFERENCES scholar_portal(portal_id)"
        },
        {
          "name": "participation_id",
          "type": "varchar(64)",
          "required": true,
          "meaning": "被展示参与关系",
          "extra": "REFERENCES achievement_participation(participation_id)"
        },
        {
          "name": "scholar_id",
          "type": "varchar(64)",
          "required": true,
          "meaning": "冗余用于复合FK验证同一学者",
          "extra": "REFERENCES scholar(scholar_id)"
        },
        {
          "name": "visible",
          "type": "boolean",
          "required": true,
          "meaning": "个人展示选择，不影响成果公共资格",
          "extra": "DEFAULT true"
        },
        {
          "name": "version",
          "type": "bigint",
          "required": true,
          "meaning": "展示配置版本",
          "extra": "DEFAULT 1 CHECK (version > 0)"
        }
      ],
      "constraints": [
        "PRIMARY KEY (portal_id, participation_id)",
        "FOREIGN KEY (portal_id, scholar_id) REFERENCES scholar_portal(portal_id, scholar_id)",
        "FOREIGN KEY (participation_id, scholar_id) REFERENCES achievement_participation(participation_id, scholar_id)"
      ]
    },
    {
      "name": "evidence_reference",
      "purpose": "私有认领材料元数据",
      "columns": [
        {
          "name": "evidence_id",
          "type": "varchar(64)",
          "required": true,
          "meaning": "材料引用ID，非下载凭据",
          "extra": "PRIMARY KEY"
        },
        {
          "name": "owner_account_id",
          "type": "varchar(64)",
          "required": true,
          "meaning": "材料归属",
          "extra": "REFERENCES app_account(account_id)"
        },
        {
          "name": "private_object_key",
          "type": "text",
          "required": true,
          "meaning": "私有对象存储键，不向公众返回",
          "extra": ""
        },
        {
          "name": "media_type",
          "type": "text",
          "required": true,
          "meaning": "经校验实际类型",
          "extra": ""
        },
        {
          "name": "size_bytes",
          "type": "bigint",
          "required": true,
          "meaning": "材料字节数",
          "extra": "CHECK (size_bytes > 0)"
        },
        {
          "name": "validation_state",
          "type": "text",
          "required": true,
          "meaning": "材料校验结果；具体安全流程待设计",
          "extra": ""
        },
        {
          "name": "created_at",
          "type": "timestamptz",
          "required": true,
          "meaning": "上传时间",
          "extra": ""
        },
        {
          "name": "expires_at",
          "type": "timestamptz",
          "required": false,
          "meaning": "按已批准保留策略计算，未定不假填期限",
          "extra": ""
        },
        {
          "name": "failure_reason",
          "type": "text",
          "required": false,
          "meaning": "脱敏校验失败分类；客户端映射可理解说明，不存证明正文或堆栈",
          "extra": ""
        }
      ],
      "constraints": [
        "UNIQUE (evidence_id, owner_account_id)"
      ]
    },
    {
      "name": "claim_request",
      "purpose": "三态认领申请",
      "columns": [
        {
          "name": "claim_id",
          "type": "varchar(64)",
          "required": true,
          "meaning": "申请ID，API候选application_id映射",
          "extra": "PRIMARY KEY"
        },
        {
          "name": "applicant_id",
          "type": "varchar(64)",
          "required": true,
          "meaning": "会话确定的申请人",
          "extra": "REFERENCES app_account(account_id)"
        },
        {
          "name": "portal_id",
          "type": "varchar(64)",
          "required": true,
          "meaning": "目标门户，通过scholar_id解析",
          "extra": "REFERENCES scholar_portal(portal_id)"
        },
        {
          "name": "status",
          "type": "text",
          "required": true,
          "meaning": "申请业务状态",
          "extra": "CHECK (status IN ('PENDING','APPROVED','REJECTED'))"
        },
        {
          "name": "version",
          "type": "bigint",
          "required": true,
          "meaning": "乐观并发版本",
          "extra": "DEFAULT 1 CHECK (version > 0)"
        },
        {
          "name": "previous_claim_id",
          "type": "varchar(64)",
          "required": false,
          "meaning": "驳回后新申请的前序引用",
          "extra": "REFERENCES claim_request(claim_id)"
        },
        {
          "name": "created_at",
          "type": "timestamptz",
          "required": true,
          "meaning": "有效创建时点",
          "extra": ""
        },
        {
          "name": "decided_at",
          "type": "timestamptz",
          "required": false,
          "meaning": "成功决定时间；待审为空",
          "extra": ""
        }
      ],
      "constraints": [
        "UNIQUE (claim_id, applicant_id)",
        "UNIQUE (claim_id, applicant_id, portal_id)",

@startuml
!pragma layout smetana
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 15
skinparam shadowing false
skinparam backgroundColor white
skinparam ArrowColor #334155
skinparam classBackgroundColor #EFF6FF
skinparam classBorderColor #38689A
skinparam sequenceParticipantBackgroundColor #EFF6FF
skinparam sequenceGroupBackgroundColor #F8FAFC
skinparam sequenceGroupBorderColor #94A3B8
hide empty members
title M8-AN-SEQ-02 提交认领与结果恢复
actor "申请人" as U
boundary "认领页面" as P
control "认领协调" as C
control "当前会话/对象资格" as A
entity "申请、材料与门户" as S
U -> P : 提交本人申请意图、材料引用
P -> C : 目标、引用、request_key
C -> A : 获取服务端主体并校验读取/提交资格
alt 会话无效或对象无权
 C --> P : 拒绝；私有对象不泄露存在性
else 有效主体
 group 同一原子边界：提交时约束仍须成立
  C -> S : 核验同主体同操作幂等记录
  alt 同键同参数且仍有结果读取资格
   S --> C : 已保存的本人申请结果
  else 同键不同参数
   S --> C : 冲突；不创建
  else 新请求
   C -> S : 校验目标、未占用、本人有效材料、待审唯一
   alt 校验不通过
    S --> C : 材料/目标/重复/占用错误
   else 校验有效
    C -> S : 原子保存PENDING申请、幂等结果及审计
    S --> C : 提交成功或整体失败
   end
  end
 end
 C --> P : 已保存结果或明确错误
 P --> U : PENDING仅可查本人申请，不产生维护权
end
note over P,S
 超时或回包丢失不证明提交失败。
 同键同参数重试，或经授权查询本人记录恢复；
 不自动生成新键再次创建。
end note
@enduml

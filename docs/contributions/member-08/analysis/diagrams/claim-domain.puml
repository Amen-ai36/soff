@startuml
!pragma layout smetana
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 15
skinparam shadowing false
skinparam backgroundColor white
skinparam ArrowColor #334155
skinparam classBackgroundColor #EFF6FF
skinparam classBorderColor #38689A
skinparam sequenceParticipantBackgroundColor #EFF6FF
skinparam sequenceGroupBackgroundColor #F8FAFC
skinparam sequenceGroupBorderColor #94A3B8
hide empty members
title M8-AN-CLS-02 门户认领、决定与授权
left to right direction
class "账号\nAccount" as Account {
 账号标识 / 有效性 / 权限资格
 +校验当前操作资格()
}
class "学者门户\nScholarPortal" as Portal {
 门户标识 / 学者标识 / 版本
 +读取当前维护资格()
}
class "认领申请\nClaimRequest" as Claim {
 申请标识 / 状态 / 版本 / 前序引用
 +创建待审申请()
 +接受一次有效决定()
}
class "私有证明引用\nEvidenceReference" as Evidence {
 材料标识 / 归属 / 有效性
 +受控提供证明()
}
class "审核决定\nReviewDecision" as Decision {
 决定 / 理由 / 前后版本 / 时间
 +记录有效业务决定()
}
class "维护授权\nPortalGrant" as Grant {
 授权标识 / 有效性 / 来源申请
 +校验资源操作资格()
}
class "操作审计\nAuditRecord" as Audit {
 操作者 / 对象 / 动作 / 版本 / 结果
 +追溯成功业务操作()
}
enum "申请状态\nClaimStatus" as Status {
 PENDING
 APPROVED
 REJECTED
}
Account "1" -- "0..*" Claim : 提交
Claim "0..*" --> "1" Portal : 申请目标
Account "1" -- "0..*" Evidence : 私有材料归属
Claim "0..*" -- "1..*" Evidence : 提交时有效引用
Claim "1" -- "0..1" Decision : 唯一有效决定
Account "1" -- "0..*" Decision : 非申请本人审核
Claim "1" -- "0..1" Grant : 通过时创建
Account "1" -- "0..*" Grant : 获得资格
Portal "1" -- "0..*" Grant : 授权历史
Account "1" -- "0..*" Audit : 操作主体
Claim "0..1" -- "1..*" Audit : 创建及成功决定轨迹
Claim --> Status : 恰一状态
Claim "0..*" --> "0..1" Claim : 驳回后新申请的前序
note bottom of Grant
 同一门户同时至多一个有效授权；
 APPROVED、授权、审核决定、审计原子提交。
 撤销、转让、多人代管未纳入当前流程。
end note
note bottom of Decision
 同一申请最多一次有效业务决定；
 失败尝试另记安全/操作事件，
 不伪装成有效决定。
end note
@enduml

@startuml
!pragma layout smetana
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 15
skinparam shadowing false
skinparam backgroundColor white
skinparam ArrowColor #334155
skinparam classBackgroundColor #EFF6FF
skinparam classBorderColor #38689A
skinparam sequenceParticipantBackgroundColor #EFF6FF
skinparam sequenceGroupBackgroundColor #F8FAFC
skinparam sequenceGroupBorderColor #94A3B8
hide empty members
title M8-AN-CLS-01 科研实体与展示关系
left to right direction
class "学者\nScholar" as Scholar {
 学者标识 / 公开姓名 / 别名线索
 +提供公开档案()
}
class "成果\nAchievement" as Work {
 成果标识 / 类型 / 题名 / 年份或未知
 公开策略 / 权威版本
 +提供公开投影()
}
class "成果参与关系\nParticipation" as Part {
 参与角色 / 顺序或未知 / 来源依据
 +确认参与主体()
}
class "机构\nInstitution" as Org {
 机构标识 / 名称 / 别名
 +提供规范身份()
}
class "成果机构关联\nWorkInstitution" as WI {
 发生时机构 / 关系依据 / 时间线索
 +解释机构归属()
}
class "学术领域\nField" as Field {
 领域标识 / 名称 / 分类体系
 +提供分类语义()
}
class "来源记录\nSourceRecord" as Source {
 来源键 / 来源版本 / 许可依据
 +追溯当前规范映射()
}
class "学者门户\nScholarPortal" as Portal {
 门户标识 / 公开配置 / 版本
 +展示四类成果()
}
class "展示选择\nPortalDisplayLink" as Display {
 展示选择 / 变更版本
 +调整本人展示()
}
enum "成果类型\nAchievementType" as Type {
 paper
 patent
 project
 award
}
Scholar "1" -- "0..*" Part : 参与主体
Work "1" -- "0..*" Part : 对应成果
Work "1" -- "0..*" WI : 发生时机构依据
Org "1" -- "0..*" WI : 关联机构
Scholar "0..*" -- "0..*" Org : 有依据的任职关系
Work "0..*" -- "0..*" Field : 规范分类
Source "0..*" --> "0..1" Work : 当前规范映射
Portal "0..1" --> "1" Scholar : 展示主体
Portal "1" -- "0..*" Display : 可选展示配置
Part "1" -- "0..*" Display : 可追溯参与关系
Work --> Type : 恰一类型
note bottom of Display
 选择记录不要求覆盖全部默认展示；
 门户学者须与参与学者一致。
 隐藏展示不删除规范成果或来源。
end note
note bottom of Source
 来源先归一到单成果记录粒度；
 公开成果至少有一个有效来源依据。
end note
@enduml

